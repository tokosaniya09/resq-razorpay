# Copy to .env and fill in. Real .env is git-ignored.
# ResQ-Pay runs fully in MOCK mode with none of these set.

# --- Razorpay (TEST MODE ONLY — never live keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=true

# --- Degradation thresholds (tunable live during the demo) ---
DEGRADATION_WINDOW_SIZE=20
DEGRADATION_WARN_THRESHOLD=0.40
DEGRADATION_CRITICAL_THRESHOLD=0.65

# --- Guardrails ---
MAX_RETRY_ATTEMPTS=2
RETRY_COOLDOWN_SECONDS=5
RECOVERY_LINK_TTL_MINUTES=15

# --- Outreach LLM (optional; falls back to templates if off) ---
LLM_ENABLED=true
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
